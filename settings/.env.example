# Copy this file to settings/.env for local development.
# settings/.env is ignored by Git and may contain local credentials.

KNOWLEDGE_AGENT_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45

# The main agent answers ordinary chat directly and only invokes RAG for
# knowledge questions. Context follow-ups are rewritten before retrieval.
QUERY_REWRITE_ENABLED=true
MODEL_LOCAL_FILES_ONLY=true

# Retrieval defaults to stable lexical BM25. Set EMBEDDING_BACKEND=local to enable
# local dense vectors. Set MODEL_LOCAL_FILES_ONLY=false once if the model is not
# cached yet; normal runs should keep it true to avoid Hub network checks.
EMBEDDING_BACKEND=none
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
MODEL_CACHE_DIR=runtime/models
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# Optional cross-encoder rerank. It always falls back to first-stage recall on failure.
RERANK_ENABLED=true
RERANK_BACKEND=local
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DEVICE=cpu
RERANK_TOP_K=8
RERANK_TIMEOUT_SECONDS=20
RERANK_API_URL=
RERANK_API_KEY=

KNOWLEDGE_AGENT_DB=runtime/knowledge.db
KNOWLEDGE_AGENT_MAX_UPLOAD_BYTES=10485760

# Chunking and bounded agent execution.
KNOWLEDGE_AGENT_CHUNK_SIZE=420
KNOWLEDGE_AGENT_CHUNK_OVERLAP=60
CHUNK_STRATEGY=auto
CHUNK_LLM_MODEL=
CHUNK_LLM_MIN_CHARS=1600
CHUNK_LLM_MAX_CHARS=12000
CHUNK_LLM_TIMEOUT_SECONDS=60
KNOWLEDGE_AGENT_MAX_STEPS=6
KNOWLEDGE_AGENT_MAX_TOOL_CALLS=8

# DOCX/PDF table extraction and optional multimodal understanding.
PARSE_PDF_TABLES=true
PARSE_EMBEDDED_IMAGES=true
VISION_ENABLED=false
VISION_MODEL=
VISION_API_URL=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=60
MAX_EMBEDDED_IMAGES=20

# Optional MinerU integration. Leave MINERU_COMMAND empty to use PyMuPDF for text PDFs.
MINERU_COMMAND=
MINERU_SERVER_URL=
MINERU_METHOD=auto
MINERU_TIMEOUT_SECONDS=300

# Optional OCR for images and scanned PDFs.
TESSERACT_COMMAND=tesseract
TESSERACT_LANG=chi_sim+eng
